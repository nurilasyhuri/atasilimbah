---
export interface Props {
  specs: {
    modelCode: string;
    nominalCapacity: string;
    testedCapacity: string;
    wasteTypes: string[];
    dimensions: string;
    constructionMaterial: string;
    combustionSystem: string;
    fuelType: string;
    fuelConsumption: string;
    electricPower: string;
    controlSystem: string;
    emissionControl: string;
    emissionTestStatus: string;
    operatorNeed: string;
    safetyFeatures: string[];
    warranty: string;
    price?: string;
    operatingTemp?: string;
    blowerSpec?: string;
    pumpSpec?: string;
    flyAshResidue?: string;
    unitWeight?: string;
  };
}

const { specs } = Astro.props;

const formattedPrice = specs.price
  ? `Rp ${Number(specs.price).toLocaleString('id-ID')},- (Harga Resmi Pabrik)`
  : 'Surat Penawaran Resmi (Hubungi Tim Engineering)';

const rows = [
  { label: 'Kode Model Mesin', value: specs.modelCode, isTech: true },
  { label: 'Kapasitas Nominal Desain', value: specs.nominalCapacity, isTech: true },
  { label: 'Kapasitas Teruji Lapangan', value: specs.testedCapacity, isTech: true },
  { label: 'Estimasi Harga Resmi', value: formattedPrice, isTech: true, isHighlight: true },
  { label: 'Suhu Operasional Ruang Bakar', value: specs.operatingTemp || '800°C - 1.000°C', isTech: true },
  { label: 'Dimensi Mesin (P x L x T)', value: specs.dimensions, isTech: true },
  { label: 'Teknologi Pembakaran', value: specs.combustionSystem },
  { label: 'Material & Lapisan Refractory', value: specs.constructionMaterial },
  { label: 'Sistem Pengendalian Emisi', value: specs.emissionControl },
  { label: 'Pilihan Bahan Bakar', value: specs.fuelType },
  { label: 'Konsumsi Bahan Bakar', value: specs.fuelConsumption, isTech: true },
  { label: 'Spesifikasi Blower Forced-Draft', value: specs.blowerSpec || '220V, 2800 RPM', isTech: true },
  { label: 'Kapasitas Pompa Sirkulasi Scrubber', value: specs.pumpSpec || '2 - 3 M³/Jam', isTech: true },
  { label: 'Kebutuhan Daya Listrik', value: specs.electricPower, isTech: true },
  { label: 'Residu Abu Padat (Flyash)', value: specs.flyAshResidue || '3 - 5%', isTech: true },
  { label: 'Perkiraan Berat Unit Mesin', value: specs.unitWeight || '± 200 - 1.500 Kg', isTech: true },
  { label: 'Jenis Sampah yang Didukung', value: specs.wasteTypes.join(', ') },
  { label: 'Sistem Kontrol Operasional', value: specs.controlSystem },
  { label: 'Kebutuhan Tenaga Operator', value: specs.operatorNeed },
  { label: 'Fitur Keselamatan (Safety)', value: specs.safetyFeatures.join('; ') },
  { label: 'Garansi Fabrikasi', value: specs.warranty },
];
---

<div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-xs">
  <table class="w-full text-left text-sm border-collapse">
    <caption class="sr-only">Tabel Spesifikasi Teknis Mesin Incinerator</caption>
    <thead>
      <tr class="border-b border-slate-800">
        <th scope="col" class="bg-slate-950 text-white py-4 px-5 font-bold text-xs uppercase tracking-wider w-1/3 font-tech">
          Parameter Teknis
        </th>
        <th scope="col" class="bg-slate-950 text-white py-4 px-5 font-bold text-xs uppercase tracking-wider w-2/3 font-tech">
          Spesifikasi Standar Pabrik
        </th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {rows.map((r, i) => (
        <tr class={r.isHighlight ? 'bg-emerald-50/70' : i % 2 === 0 ? 'bg-white' : 'bg-slate-50/60'}>
          <th scope="row" class="py-3 px-5 font-semibold text-slate-900 text-xs">
            {r.label}
          </th>
          <td class={`py-3 px-5 text-xs leading-relaxed ${r.isHighlight ? 'text-[#123F35] font-bold' : 'text-slate-800'} ${r.isTech ? 'font-tech' : ''}`}>
            {r.value}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
