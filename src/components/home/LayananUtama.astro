---
// Layanan Utama section with Primary Dark Green (#1E482C) and Pure White (#FFFFFF)
---

<section class="py-16 sm:py-20 lg:py-24 bg-white border-b border-[#E2E6E1]" aria-label="Layanan Utama Pengolahan Sampah">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-10 sm:mb-14">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#1E2926] tracking-tight leading-tight">
        Layanan Pengolahan Sampah Termal
      </h2>
    </div>

    <!-- 3-Column Image Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      <!-- Card 1 -->
      <a href="/incinerator-sampah-kering/" class="group block focus:outline-none">
        <div class="overflow-hidden rounded-2xl bg-[#F3F5F2] aspect-[16/11] mb-4 border border-[#E2E6E1] shadow-2xs">
          <img
            src="/images/incinerator-vertical-unit.webp"
            alt="Incinerator Sampah Kering & Domestik AtasiLimbah"
            class="w-full h-full object-cover group-hover:scale-104 transition-transform duration-200"
            width="800"
            height="550"
            loading="lazy"
          />
        </div>
        <div class="space-y-1.5 px-1">
          <h3 class="text-base sm:text-lg font-bold text-[#1E2926] group-hover:text-[#1E482C] transition-colors">
            Incinerator Sampah Kering & Residu Padat
          </h3>
          <span class="text-xs font-bold text-[#1E482C] font-tech inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
            Detail Spesifikasi &rarr;
          </span>
        </div>
      </a>

      <!-- Card 2 -->
      <a href="/incinerator-sampah-basah/" class="group block focus:outline-none">
        <div class="overflow-hidden rounded-2xl bg-[#F3F5F2] aspect-[16/11] mb-4 border border-[#E2E6E1] shadow-2xs">
          <img
            src="/images/incinerator-high-temp.webp"
            alt="Incinerator Sampah Basah & Organik AtasiLimbah"
            class="w-full h-full object-cover group-hover:scale-104 transition-transform duration-200"
            width="800"
            height="550"
            loading="lazy"
          />
        </div>
        <div class="space-y-1.5 px-1">
          <h3 class="text-base sm:text-lg font-bold text-[#1E2926] group-hover:text-[#1E482C] transition-colors">
            Incinerator Sampah Basah & Organik
          </h3>
          <span class="text-xs font-bold text-[#1E482C] font-tech inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
            Detail Spesifikasi &rarr;
          </span>
        </div>
      </a>

      <!-- Card 3 -->
      <a href="/incinerator-custom/" class="group block focus:outline-none">
        <div class="overflow-hidden rounded-2xl bg-[#F3F5F2] aspect-[16/11] mb-4 border border-[#E2E6E1] shadow-2xs">
          <img
            src="/images/incinerator-wet-scrubber.webp"
            alt="Sistem Incinerator Custom & Scrubber AtasiLimbah"
            class="w-full h-full object-cover group-hover:scale-104 transition-transform duration-200"
            width="800"
            height="550"
            loading="lazy"
          />
        </div>
        <div class="space-y-1.5 px-1">
          <h3 class="text-base sm:text-lg font-bold text-[#1E2926] group-hover:text-[#1E482C] transition-colors">
            Rancang Bangun Incinerator Custom & Scrubber
          </h3>
          <span class="text-xs font-bold text-[#1E482C] font-tech inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
            Detail Spesifikasi &rarr;
          </span>
        </div>
      </a>
    </div>
  </div>
</section>