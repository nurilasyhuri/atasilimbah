---
// Hero section with Pure Green (#123F35) and Clean White (#FFFFFF)
---

<section class="relative w-full min-h-[500px] sm:min-h-[580px] lg:min-h-[660px] bg-[#123F35] text-white overflow-hidden flex flex-col justify-between" aria-label="Hero Mesin Incinerator Dual Chamber AtasiLimbah">
  <!-- Full-Bleed Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero-incinerator.webp"
      alt="Instalasi Mesin Incinerator Dual Chamber AtasiLimbah"
      class="w-full h-full object-cover object-center scale-100 transition-transform duration-200"
      width="1388"
      height="536"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Deep Primary Dark Green Vignette -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#123F35] via-[#123F35]/90 to-[#123F35]/40 md:to-[#123F35]/20 lg:to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#123F35] via-[#123F35]/30 to-[#123F35]/70"></div>
  </div>

  <!-- Hero Slider Side Navigation Arrows -->
  <div class="hidden lg:flex absolute inset-y-0 left-4 items-center z-20 pointer-events-none">
    <button type="button" aria-label="Slide sebelumnya" class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 flex items-center justify-center text-white transition-colors pointer-events-auto backdrop-blur-xs">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
  </div>
  <div class="hidden lg:flex absolute inset-y-0 right-4 items-center z-20 pointer-events-none">
    <button type="button" aria-label="Slide berikutnya" class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 flex items-center justify-center text-white transition-colors pointer-events-auto backdrop-blur-xs">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>

  <!-- Hero Content Body -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-10 sm:pt-16 lg:pt-20 pb-5 sm:pb-8 flex-1 flex flex-col justify-center">
    <div class="max-w-3xl space-y-3 sm:space-y-4">
      <!-- Main Headline: Pure clean white typography (<= 2 lines on desktop) -->
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight max-w-2xl">
        Mesin Incinerator Dual Chamber Standar KLHK
      </h1>

      <!-- Concise Subheading -->
      <p class="text-xs sm:text-base text-white/90 font-normal max-w-xl leading-relaxed">
        Fabrikasi mesin incinerator pengolahan sampah ramah lingkungan suhu 800°C–1.200°C dan cyclone scrubber.
      </p>

      <!-- Primary Action CTA -->
      <div class="pt-1 flex flex-wrap items-center gap-4">
        <a
          href="#konsultasi"
          class="inline-flex items-center justify-center gap-2.5 px-7 py-3 sm:px-8 sm:py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs sm:text-sm tracking-wide transition-colors duration-150 shadow-xl shadow-black/40 active:scale-98"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current text-white" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.12-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.72 4.31 3.81.6.26 1.07.42 1.44.54.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.12-.23-.19-.48-.31z"/>
          </svg>
          <span>Chat WhatsApp 0851-8300-5070</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Stats Strip (All clean white text >= 12px) -->
  <div class="relative z-10 w-full border-t border-white/15 bg-[#123F35]/90 backdrop-blur-xs py-3.5 sm:py-5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 sm:gap-6">
        <!-- 4 Stats Columns -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-8 flex-1">
          <div>
            <div class="flex items-baseline gap-1">
              <span class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white">800 - 1.200</span>
              <span class="text-xs font-bold text-white/80">°C</span>
            </div>
            <div class="text-xs text-white/80 mt-0.5 font-medium">Suhu Dual Chamber</div>
          </div>

          <div>
            <div class="flex items-baseline gap-1">
              <span class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white">200 Kg - 1</span>
              <span class="text-xs font-bold text-white/80">Ton</span>
            </div>
            <div class="text-xs text-white/80 mt-0.5 font-medium">Kapasitas Harian</div>
          </div>

          <div>
            <div class="flex items-baseline gap-1">
              <span class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white">12 Bulan</span>
            </div>
            <div class="text-xs text-white/80 mt-0.5 font-medium">Garansi Fabrikasi</div>
          </div>

          <div>
            <div class="flex items-baseline gap-1">
              <span class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white">KLHK P.70</span>
            </div>
            <div class="text-xs text-white/80 mt-0.5 font-medium">Standar Baku Mutu</div>
          </div>
        </div>

        <!-- Slider Progress Indicator -->
        <div class="hidden lg:flex items-center gap-1.5 shrink-0" aria-hidden="true">
          <span class="w-8 h-1 bg-white rounded-full"></span>
          <span class="w-2 h-1 bg-white/40 rounded-full"></span>
          <span class="w-2 h-1 bg-white/40 rounded-full"></span>
          <span class="w-2 h-1 bg-white/40 rounded-full"></span>
        </div>
      </div>
    </div>
  </div>
</section>