---
// Konsultasi Tim Profesional section with Primary Dark Green (#123F35) and Pure White (#FFFFFF)
import { COMPANY_INFO } from '../../data/companyInfo';

const waUrl = `https://wa.me/${COMPANY_INFO.contact.whatsappNumber}?text=${encodeURIComponent('Halo Tim AtasiLimbah, saya ingin konsultasi estimasi pengadaan mesin incinerator.')}`;
---

<section id="konsultasi" class="py-16 sm:py-20 lg:py-24 bg-white border-b border-[#E2E6E1]" aria-label="Konsultasi Teknis Tim Profesional">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-16 items-center">
      <!-- Left Column: Engineer Portrait -->
      <div class="md:col-span-5 lg:col-span-5">
        <div class="space-y-3">
          <div class="rounded-2xl overflow-hidden aspect-[4/5] bg-slate-100 border border-[#E2E6E1]">
            <img
              src="/images/lead-engineer-consultant.webp"
              alt="Lead Engineer Tim Rekayasa Termal AtasiLimbah"
              class="w-full h-full object-cover"
              width="600"
              height="750"
              loading="lazy"
            />
          </div>
          <div class="px-1 flex items-baseline justify-between gap-2">
            <span class="text-sm font-bold text-[#1E2926]">Tim Rekayasa Termal</span>
            <span class="text-xs font-semibold text-[#123F35] font-tech">Lead Incinerator Engineer</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Heading, Reassurance Checklist, & Primary Action -->
      <div class="md:col-span-7 lg:col-span-7 space-y-6 sm:space-y-8">
        <div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#1E2926] tracking-tight leading-tight">
            Konsultasi Mesin & Estimasi Proyek
          </h2>
          <p class="text-sm sm:text-base text-[#576360] mt-3 leading-relaxed">
            Konsultasi teknis langsung dengan tim rekayasa kami untuk menghitung kapasitas timbulan sampah harian, kesesuaian ruang bakar, dan efisiensi bahan bakar fasilitas Anda.
          </p>
        </div>

        <!-- 3 Reassurance Checklist with Green Checkmarks -->
        <div class="space-y-3.5">
          <div class="flex items-start gap-3">
            <div class="w-5 h-5 rounded-full bg-[#123F35]/10 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5 text-[#123F35]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <span class="text-xs sm:text-sm text-[#1E2926] leading-snug">
              Respon cepat via WhatsApp Hotline <strong class="text-[#123F35] font-tech font-bold">0851-8300-5070</strong>
            </span>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-5 h-5 rounded-full bg-[#123F35]/10 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5 text-[#123F35]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <span class="text-xs sm:text-sm text-[#1E2926] leading-snug">
              Gratis analisis komposisi sampah & Bill of Quantity (BOQ) presisi tanpa pemborosan
            </span>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-5 h-5 rounded-full bg-[#123F35]/10 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5 text-[#123F35]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <span class="text-xs sm:text-sm text-[#1E2926] leading-snug">
              Pengiriman tepat waktu, perakitan on-site, dan pelatihan operator ke seluruh Indonesia
            </span>
          </div>
        </div>

        <!-- Primary Pill Button -->
        <div class="pt-2">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm sm:text-base tracking-wide transition-colors duration-150 shadow-xl shadow-black/20 active:scale-98"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.12-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.72 4.31 3.81.6.26 1.07.42 1.44.54.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.12-.23-.19-.48-.31z"/>
            </svg>
            <span>Chat WhatsApp: 0851-8300-5070</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>