---
// Lokasi Workshop section directly modeled after mscscaffolding.com "Gudang Surabaya & Sidoarjo"
---

<section class="py-16 sm:py-20 lg:py-24 bg-white border-b border-slate-100" aria-label="Lokasi Fasilitas Fisik Workshop">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-10 sm:mb-14">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-950 tracking-tight leading-tight">
        Workshop Solo & Klaten
      </h2>
    </div>

    <!-- 2 Workshop Depot Cards (MSC Scaffolding visual style) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Depot 1: Solo -->
      <div class="space-y-4">
        <div class="relative rounded-2xl overflow-hidden aspect-[16/10] bg-slate-100 border border-slate-200 shadow-2xs group">
          <img
            src="/images/workshop-solo-depot.webp"
            alt="Workshop Fabrikasi Incinerator Solo"
            class="w-full h-full object-cover group-hover:scale-104 transition-transform duration-200"
            width="800"
            height="500"
            loading="lazy"
          />
          <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-slate-950/80 backdrop-blur-xs text-white text-xs font-semibold font-tech">
            Depot Solo
          </span>
        </div>

        <div class="space-y-2 px-1">
          <h3 class="text-lg sm:text-xl font-bold text-slate-950">
            Workshop Fabrikasi Solo (Pusat Perakitan)
          </h3>
          <div class="flex items-center gap-1.5 text-xs text-slate-600">
            <svg class="w-4 h-4 text-orange-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>Kawasan Industri Fabrikasi Logam Solo, Jawa Tengah</span>
          </div>
          <p class="text-xs text-slate-500">
            Jangkauan: Solo Raya, Semarang, Yogyakarta, Jawa Timur, Jawa Barat & Pengiriman Seluruh Indonesia.
          </p>

          <div class="pt-3 flex items-center justify-between">
            <a
              href="https://maps.google.com"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-xs font-semibold text-slate-700 hover:text-orange-600 transition-colors"
            >
              <span>Google Maps</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>

            <a
              href="/kontak/"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-950 hover:bg-slate-800 text-white text-xs font-semibold transition-colors duration-150 shadow-2xs"
            >
              <svg class="w-3.5 h-3.5 text-orange-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              <span>Hubungi Workshop</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Depot 2: Klaten -->
      <div class="space-y-4">
        <div class="relative rounded-2xl overflow-hidden aspect-[16/10] bg-slate-100 border border-slate-200 shadow-2xs group">
          <img
            src="/images/workshop-klaten-depot.webp"
            alt="Workshop Perakitan Siklon Klaten"
            class="w-full h-full object-cover group-hover:scale-104 transition-transform duration-200"
            width="800"
            height="500"
            loading="lazy"
          />
          <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-slate-950/80 backdrop-blur-xs text-white text-xs font-semibold font-tech">
            Depot Klaten
          </span>
        </div>

        <div class="space-y-2 px-1">
          <h3 class="text-lg sm:text-xl font-bold text-slate-950">
            Workshop Perakitan Klaten (Siklon & Scrubber)
          </h3>
          <div class="flex items-center gap-1.5 text-xs text-slate-600">
            <svg class="w-4 h-4 text-orange-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>Sentra Fabrikasi Pengelasan & Ducting Klaten, Jawa Tengah</span>
          </div>
          <p class="text-xs text-slate-500">
            Jangkauan: Fabrikasi cerobong tahan suhu tinggi, siklon partikulat fly ash, dan modul wet scrubber.
          </p>

          <div class="pt-3 flex items-center justify-between">
            <a
              href="https://maps.google.com"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-xs font-semibold text-slate-700 hover:text-orange-600 transition-colors"
            >
              <span>Google Maps</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>

            <a
              href="/kontak/"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-950 hover:bg-slate-800 text-white text-xs font-semibold transition-colors duration-150 shadow-2xs"
            >
              <svg class="w-3.5 h-3.5 text-orange-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              <span>Hubungi Workshop</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
