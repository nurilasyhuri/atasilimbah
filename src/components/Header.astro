---
import { COMPANY_INFO } from '../data/companyInfo';

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === '/') {
    return pathname === '/' || pathname === '';
  }
  return pathname.startsWith(href);
};
---

<header class="sticky top-0 z-50 w-full bg-[#1E482C] border-b border-white/15 text-white transition-colors duration-150">
  <!-- Main Navbar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18 sm:h-20">
      <!-- Brand Logo / Wordmark (All clean white) -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none shrink-0" aria-label="Beranda AtasiLimbah">
        <div class="w-10 h-10 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-white group-hover:bg-white/20 transition-colors duration-150 shadow-xs">
          <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
          </svg>
        </div>
        <div>
          <div class="text-lg sm:text-xl font-bold tracking-tight text-white leading-tight">
            ATASI<span class="font-extrabold text-white">LIMBAH</span>
          </div>
          <div class="text-xs uppercase tracking-wider font-medium text-white/80 leading-tight">
            PT ATASI LIMBAH INDONESIA
          </div>
        </div>
      </a>

      <!-- Desktop Navigation with Interactive Product Dropdown Button -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Navigasi Utama">
        {COMPANY_INFO.navItems.map((item) => {
          const active = isCurrent(item.href);

          if (item.hasDropdown) {
            return (
              <div class="relative group">
                <a
                  href={item.href}
                  class={`inline-flex items-center gap-1.5 min-h-[38px] text-sm px-4 py-1.5 rounded-full transition-colors duration-150 font-medium ${
                    active
                      ? 'text-white bg-white/20 font-bold shadow-xs'
                      : 'text-white/90 hover:text-white hover:bg-white/10'
                  }`}
                  aria-current={active ? 'page' : undefined}
                >
                  <span>{item.label}</span>
                  <svg class="w-3.5 h-3.5 text-white group-hover:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </a>

                <!-- Floating Dropdown Card (Deep Green & Clean White) -->
                <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-opacity duration-200 z-50 w-[420px] pointer-events-none group-hover:pointer-events-auto">
                  <div class="bg-[#153620] border border-white/15 rounded-2xl p-3 shadow-2xl shadow-black/60 backdrop-blur-md">
                    <div class="px-3 py-2 text-xs font-bold uppercase tracking-wider text-white font-tech border-b border-white/10 mb-1.5 flex items-center justify-between">
                      <span>PILIHAN KATEGORI PRODUK</span>
                      <a href="/mesin-incinerator/" class="text-xs normal-case text-white/80 hover:text-white font-normal underline">Semua Unit &rarr;</a>
                    </div>

                    <div class="space-y-1">
                      {COMPANY_INFO.productCategories.map((cat, idx) => (
                        <a
                          href={`/${cat.slug}/`}
                          class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-white/10 transition-colors"
                        >
                          <span class="w-6 h-6 rounded-lg bg-white/10 border border-white/15 text-white flex items-center justify-center font-tech text-xs font-bold shrink-0 mt-0.5 group-hover/item:bg-white group-hover/item:text-[#1E482C] transition-colors">
                            {idx + 1}
                          </span>
                          <div class="flex-1 min-w-0">
                            <div class="text-xs sm:text-sm font-semibold text-white transition-colors">
                              {cat.title}
                            </div>
                            <div class="text-xs text-white/70 line-clamp-1 mt-0.5">
                              {cat.target}
                            </div>
                          </div>
                        </a>
                      ))}
                    </div>

                    <div class="mt-2 pt-2 border-t border-white/10 px-2 flex items-center justify-between">
                      <a
                        href="/mesin-incinerator/"
                        class="text-xs font-semibold text-white hover:underline flex items-center gap-1 transition-colors"
                      >
                        <span>Lihat Seluruh Katalog & Spesifikasi</span>
                        <span>&rarr;</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a
              href={item.href}
              class={`inline-flex items-center min-h-[38px] text-sm px-4 py-1.5 rounded-full transition-colors duration-150 font-medium ${
                active
                  ? 'text-white bg-white/20 font-bold shadow-xs'
                  : 'text-white/90 hover:text-white hover:bg-white/10'
              }`}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right Action Button: Minta SPH (Putih Bersih) -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href="/permintaan-penawaran/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white hover:bg-slate-100 text-[#1E482C] text-xs sm:text-sm font-bold shadow-md shadow-black/20 transition-colors duration-150"
        >
          <svg class="w-4 h-4 text-[#1E482C]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span>Minta SPH</span>
        </a>
      </div>

      <!-- Mobile / Tablet Menu Button -->
      <div class="flex lg:hidden">
        <button
          type="button"
          id="mobile-menu-toggle"
          class="inline-flex items-center justify-center p-2 rounded-lg text-white hover:bg-white/10 border border-white/20 focus:outline-none focus:ring-2 focus:ring-white"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Buka menu navigasi"
        >
          <svg id="menu-icon-open" class="w-6 h-6 block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile / Tablet Navigation Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-white/15 bg-[#153620] px-4 pt-3 pb-6 space-y-2">
    {COMPANY_INFO.navItems.map((item) => {
      const active = isCurrent(item.href);

      if (item.hasDropdown) {
        return (
          <div class="space-y-1">
            <div class="flex items-center justify-between px-3 py-2 text-sm font-semibold text-white border-b border-white/10">
              <span>{item.label}</span>
              <a href={item.href} class="text-xs text-white/80 font-normal hover:underline">Semua Unit &rarr;</a>
            </div>
            <div class="py-1 space-y-1">
              {COMPANY_INFO.productCategories.map((cat, idx) => (
                <a
                  href={`/${cat.slug}/`}
                  class="flex items-center gap-2.5 px-3 py-2 text-xs text-white/90 hover:text-white hover:bg-white/10 rounded-lg transition-colors"
                >
                  <span class="w-5 h-5 rounded bg-white/10 text-white text-xs font-bold flex items-center justify-center font-tech shrink-0">
                    {idx + 1}
                  </span>
                  <span class="font-medium text-white">{cat.title}</span>
                </a>
              ))}
            </div>
          </div>
        );
      }

      return (
        <a
          href={item.href}
          class={`flex items-center min-h-[44px] px-3 py-2 text-sm font-medium rounded-lg transition-colors ${
            active
              ? 'text-white bg-white/20 font-bold'
              : 'text-white/80 hover:text-white hover:bg-white/10'
          }`}
          aria-current={active ? 'page' : undefined}
        >
          {item.label}
        </a>
      );
    })}

    <div class="pt-3 border-t border-white/10 flex flex-col gap-2">
      <a
        href="/permintaan-penawaran/"
        class="flex items-center justify-center gap-2 w-full py-2.5 rounded-full bg-white text-[#1E482C] text-xs font-bold shadow-xs hover:bg-slate-100"
      >
        <span>Minta Surat Penawaran SPH</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && mobileMenu && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
