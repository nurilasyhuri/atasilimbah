---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COMPANY_INFO } from '../../data/companyInfo';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const data = article.data;
const { Content } = await render(article);

const pageTitle = `${data.title} - ${COMPANY_INFO.name}`;
const pageDescription = data.description;
const canonicalUrl = `${COMPANY_INFO.domain}/artikel/${article.id}/`;

const waText = encodeURIComponent(`Halo Tim AtasiLimbah, saya telah membaca artikel "${data.title}" dan ingin konsultasi kebutuhan mesin incinerator untuk proyek kami.`);
const waUrl = `https://wa.me/${COMPANY_INFO.contact.whatsappNumber}?text=${waText}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  image: [data.heroImage || `${COMPANY_INFO.domain}/images/articles/technology-cover.webp`],
  datePublished: data.publishDate,
  author: {
    '@type': 'Organization',
    name: data.author,
    url: COMPANY_INFO.domain,
  },
  publisher: {
    '@type': 'Organization',
    name: COMPANY_INFO.name,
    url: COMPANY_INFO.domain,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Beranda',
      item: COMPANY_INFO.domain,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Artikel & Panduan',
      item: `${COMPANY_INFO.domain}/artikel/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: data.title,
      item: canonicalUrl,
    },
  ],
};

const schemas = [breadcrumbSchema, articleSchema];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  type="article"
  jsonLd={schemas}
>
  <!-- Breadcrumb -->
  <div class="bg-gray-50 border-b border-gray-200 py-3.5">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center space-x-2 text-xs text-gray-500 overflow-x-auto" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#1E482C] transition-colors">Beranda</a>
        <span>/</span>
        <a href="/artikel/" class="hover:text-[#1E482C] transition-colors">Artikel</a>
        <span>/</span>
        <span class="text-gray-900 font-medium truncate">{data.title}</span>
      </nav>
    </div>
  </div>

  <!-- Article Container -->
  <article class="py-12 sm:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Article Header -->
      <header class="mb-10 text-center sm:text-left">
        <div class="inline-flex items-center gap-2 mb-4">
          <span class="bg-[#1E482C]/10 text-[#1E482C] text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full">
            {data.category}
          </span>
          <span class="text-xs text-gray-400">
            • {data.publishDate}
          </span>
          <span class="text-xs text-gray-400">
            • {data.readingTime}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#1E2926] tracking-tight leading-tight mb-6">
          {data.title}
        </h1>

        <p class="text-base sm:text-lg text-gray-600 font-light leading-relaxed mb-6">
          {data.description}
        </p>

        <div class="flex items-center gap-3 pt-4 border-t border-gray-100 text-xs text-gray-500">
          <span>Ditulis oleh: <strong class="text-gray-800">{data.author}</strong></span>
        </div>
      </header>

      <!-- Hero Image -->
      <div class="mb-12 rounded-2xl overflow-hidden border border-gray-200 aspect-video shadow-xs bg-gray-100">
        <img
          src={data.heroImage || '/images/articles/technology-cover.webp'}
          alt={data.title}
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Markdown Body -->
      <div class="article-content max-w-none text-[#1E2926] leading-relaxed text-base font-light mb-16">
        <Content />
      </div>

      <!-- Tags & Share Footer -->
      <footer class="pt-8 border-t border-gray-200 mb-12">
        <div class="flex flex-wrap items-center gap-2 mb-8">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-500 mr-2">Topik Terkait:</span>
          {data.tags.map((tag: string) => (
            <span class="bg-gray-100 text-gray-700 text-xs px-3 py-1 rounded-md font-medium">
              #{tag}
            </span>
          ))}
        </div>

        <!-- Consultation Banner Callout -->
        <div class="bg-[#1E482C] text-white p-8 rounded-2xl shadow-xl text-center sm:text-left sm:flex items-center justify-between gap-8">
          <div>
            <span class="text-xs uppercase tracking-widest text-white/80 font-bold block mb-1">Konsultasi Teknis</span>
            <h3 class="text-xl sm:text-2xl font-bold text-white mb-2">
              Butuh Solusi Pengolahan Sampah & Limbah B3 Berizin?
            </h3>
            <p class="text-sm text-white/80 font-light leading-relaxed max-w-xl">
              Diskusikan volume timbulan sampah, jenis limbah padat, dan rancangan sistem incinerator terbaik bersama engineer ahli AtasiLimbah.
            </p>
          </div>
          <div class="mt-6 sm:mt-0 shrink-0">
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-6 py-3 bg-white text-[#1E482C] font-bold text-sm rounded-xl hover:bg-gray-100 transition-colors shadow-sm"
            >
              Hubungi WhatsApp
            </a>
          </div>
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .article-content h2 {
    font-size: 1.75rem;
    font-weight: 800;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: #1E2926;
    border-bottom: 2px solid #E5E7EB;
    padding-bottom: 0.5rem;
    line-height: 1.3;
  }
  .article-content h3 {
    font-size: 1.35rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: #1E482C;
    line-height: 1.4;
  }
  .article-content p {
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }
  .article-content ul, .article-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .article-content li {
    margin-bottom: 0.5rem;
  }
  .article-content blockquote {
    border-left: 4px solid #1E482C;
    padding-left: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    background: #F8FAF9;
    padding-top: 1rem;
    padding-bottom: 1rem;
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .article-content table {
    width: 100%;
    margin-top: 1.5rem;
    margin-bottom: 2rem;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .article-content th {
    background-color: #1E482C;
    color: #FFFFFF;
    border: 1px solid #153620;
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 700;
  }
  .article-content td {
    border: 1px solid #E5E7EB;
    padding: 0.75rem 1rem;
  }
  .article-content tr:nth-child(even) {
    background-color: #F9FAFB;
  }
  .article-content a {
    color: #1E482C;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-content a:hover {
    color: #2D6A4F;
  }
</style>
