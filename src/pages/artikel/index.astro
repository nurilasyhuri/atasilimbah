---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COMPANY_INFO } from '../../data/companyInfo';

const articles = (await getCollection('articles')).sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const pageTitle = `Artikel & Panduan Teknologi Termal Pengolahan Limbah - ${COMPANY_INFO.name}`;
const pageDescription = 'Kumpulan artikel teknis, standar baku mutu KLHK, panduan operasional mesin incinerator, pirolisis biochar, dan sistem reduksi sampah terpadu.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Beranda',
      item: COMPANY_INFO.domain,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Artikel & Panduan',
      item: `${COMPANY_INFO.domain}/artikel/`,
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`${COMPANY_INFO.domain}/artikel/`}
  jsonLd={breadcrumbSchema}
>
  <!-- Hero Section -->
  <section class="bg-[#1E482C] text-white py-16 sm:py-20 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center sm:text-left">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-white/10 text-white border border-white/20 mb-4">
          Knowledge Base & Panduan Rekayasa
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
          Artikel & Panduan Pengolahan Limbah
        </h1>
        <p class="text-base sm:text-lg text-white/80 leading-relaxed font-light">
          Panduan komprehensif seputar teknologi termal, insenerasi dua ruang bakar (dual chamber), konversi biomassa biochar, kepatuhan baku mutu emisi KLHK, dan efisiensi pengelolaan sampah mandiri.
        </p>
      </div>
    </div>
  </section>

  <!-- Article Listing Grid -->
  <section class="py-16 bg-[#F8FAF9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {articles.length === 0 ? (
        <div class="text-center py-20 bg-white rounded-2xl border border-gray-200">
          <p class="text-gray-500">Artikel sedang dalam proses penyiapan oleh tim teknis kami.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {articles.map((art) => (
            <article class="bg-white rounded-2xl border border-gray-200 shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between overflow-hidden group">
              <a href={`/artikel/${art.id}/`} class="block aspect-video overflow-hidden relative bg-gray-100">
                <img
                  src={art.data.heroImage || '/images/articles/technology-cover.webp'}
                  alt={art.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
                <span class="absolute top-3 left-3 bg-[#1E482C]/90 text-white text-xs font-semibold px-2.5 py-1 rounded-md backdrop-blur-xs">
                  {art.data.category}
                </span>
              </a>

              <div class="p-6 flex flex-col flex-grow justify-between">
                <div>
                  <div class="flex items-center gap-2 text-xs text-gray-400 mb-3">
                    <span>{art.data.publishDate}</span>
                    <span>•</span>
                    <span>{art.data.readingTime}</span>
                  </div>
                  <h2 class="text-xl font-bold text-[#1E2926] group-hover:text-[#1E482C] transition-colors leading-snug mb-3">
                    <a href={`/artikel/${art.id}/`}>
                      {art.data.title}
                    </a>
                  </h2>
                  <p class="text-sm text-gray-600 line-clamp-3 leading-relaxed mb-6 font-light">
                    {art.data.description}
                  </p>
                </div>

                <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
                  <span class="text-xs text-gray-500 font-medium">{art.data.author}</span>
                  <a
                    href={`/artikel/${art.id}/`}
                    class="text-xs font-bold text-[#1E482C] group-hover:underline inline-flex items-center gap-1"
                  >
                    <span>Baca Detail</span>
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
