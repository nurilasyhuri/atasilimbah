---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY_INFO } from '../data/companyInfo';

const pageTitle = 'Kontak Resmi dan Lokasi Workshop Fabrikasi - AtasiLimbah';
const pageDescription = 'Hubungi tim teknis dan pemasaran PT Atasi Limbah Indonesia untuk konsultasi pemilihan mesin incinerator dan jadwal kunjungan workshop.';

const waText = encodeURIComponent('Halo Tim AtasiLimbah, saya ingin menghubungi tim perwakilan untuk konsultasi teknis pengadaan incinerator.');
const waUrl = `https://wa.me/${COMPANY_INFO.contact.whatsappNumber}?text=${waText}`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Header -->
  <section class="bg-[#F3F5F2] py-12 lg:py-16 border-b border-[#E2E6E1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-[#576360] mb-4" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1.5">
          <li><a href="/" class="hover:underline">Beranda</a></li>
          <li><span>/</span></li>
          <li class="font-semibold text-[#1E482C]">Hubungi Kami</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1E482C] tracking-tight mb-4">
          Hubungi Tim Teknis AtasiLimbah
        </h1>
        <p class="text-base text-[#576360] leading-relaxed">
          Kami siap melayani diskusi teknis, evaluasi dokumen spesifikasi, penjadwalan survei lapangan, serta penerbitan penawaran resmi.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Cards & Info -->
  <section class="py-16 bg-white border-b border-[#E2E6E1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div class="p-6 bg-[#F3F5F2] rounded-lg border border-[#E2E6E1] space-y-3">
          <div class="w-10 h-10 rounded bg-[#1E482C] text-white flex items-center justify-center">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <h2 class="text-lg font-bold text-[#1E482C]">Workshop & Fabrikasi</h2>
          <p class="text-xs sm:text-sm text-[#576360] leading-relaxed">
            {COMPANY_INFO.contact.workshopAddress}
          </p>
          <div class="pt-2 text-xs text-[#576360]">
            <span class="block font-semibold text-[#1E482C]">Jam Operasional:</span>
            <span>{COMPANY_INFO.contact.operationalHours}</span>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="p-6 bg-[#F3F5F2] rounded-lg border border-[#E2E6E1] space-y-3">
          <div class="w-10 h-10 rounded bg-[#1E482C] text-white flex items-center justify-center">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <h2 class="text-lg font-bold text-[#1E482C]">Email Korespondensi</h2>
          <p class="text-xs sm:text-sm text-[#576360] leading-relaxed">
            Kirimkan berkas TOR / Term of Reference proyek Anda via email resmi:
          </p>
          <div class="pt-2">
            <a href={`mailto:${COMPANY_INFO.contact.email}`} class="text-sm font-semibold text-[#1E482C] underline underline-offset-2">
              {COMPANY_INFO.contact.email}
            </a>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="p-6 bg-[#F3F5F2] rounded-lg border border-[#E2E6E1] space-y-3">
          <div class="w-10 h-10 rounded bg-[#1E482C] text-white flex items-center justify-center">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <h2 class="text-lg font-bold text-[#1E482C]">Hotline Konsultasi Teknis</h2>
          <p class="text-xs sm:text-sm text-[#576360] leading-relaxed">
            Layanan tanya jawab teknis pra-pengadaan langsung bersama tim rekayasa:
          </p>
          <div class="pt-2">
            <span class="text-sm font-bold text-[#1E482C] font-tech block">
              {COMPANY_INFO.contact.phoneFormatted}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contextual Single Consultation CTA -->
  <section class="py-16 bg-[#1E482C] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
        Siap Mendiskusikan Spesifikasi Mesin Anda?
      </h2>
      <p class="text-sm sm:text-base text-slate-200 leading-relaxed max-w-2xl mx-auto">
        Kirimkan ringkasan kebutuhan Anda melalui formulir online atau hubungi tim teknis kami secara langsung.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-bold text-[#1E482C] bg-white hover:bg-slate-100 rounded shadow-xs transition-colors"
        >
          Hubungi via WhatsApp Resmi
        </a>
        <a
          href="/permintaan-penawaran/"
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold text-white bg-white/10 hover:bg-white/20 border border-white/20 rounded transition-colors"
        >
          Isi Formulir Penawaran (RFQ)
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
