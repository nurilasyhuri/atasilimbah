---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { COMPANY_INFO } from '../data/companyInfo';

const allProducts = await getCollection('products');
const wetProducts = allProducts.filter((p) => p.data.category === 'sampah-basah');

const pageTitle = 'Mesin Incinerator Sampah Basah dan Organik - AtasiLimbah';
const pageDescription = 'Solusi incinerator sampah basah dengan evaluasi nilai kalor dan ruang pemanas awal untuk limbah sisa makanan hotel, resort, dan pasar terpilah.';

const waText = encodeURIComponent('Halo Tim AtasiLimbah, saya ingin berkonsultasi mengenai pengolahan termal sampah basah / organik fasilitas kami.');
const waUrl = `https://wa.me/${COMPANY_INFO.contact.whatsappNumber}?text=${waText}`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Header -->
  <section class="bg-[#F3F5F2] py-12 lg:py-16 border-b border-[#E2E6E1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-[#576360] mb-4" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1.5">
          <li><a href="/" class="hover:underline">Beranda</a></li>
          <li><span>/</span></li>
          <li><a href="/mesin-incinerator/" class="hover:underline">Produk</a></li>
          <li><span>/</span></li>
          <li class="font-semibold text-[#123F35]">Sampah Basah</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-[#123F35]/10 text-[#123F35] text-xs font-bold rounded mb-3 font-tech">
          KATEGORI 02 — HIGH MOISTURE THERMAL
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#123F35] tracking-tight mb-4">
          Mesin Incinerator Sampah Basah
        </h1>
        <p class="text-base text-[#576360] leading-relaxed">
          Solusi rekayasa termal untuk material dengan kandungan air lebih tinggi setelah melalui evaluasi nilai kalor dan kelayakan proses. Dilengkapi zona pemanasan awal (*pre-drying hearth*) dan sistem kendali uap.
        </p>
      </div>
    </div>
  </section>

  <!-- Technical Boundary Notice -->
  <section class="py-6 bg-[#F3F5F2] border-b border-[#123F35]/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-start gap-3 text-xs sm:text-sm text-[#1E2926]">
        <span class="font-bold text-[#123F35] shrink-0 uppercase tracking-wide">Pemberitahuan Teknis:</span>
        <p class="leading-relaxed">
          Tidak semua sampah basah cocok diinsinerasi secara langsung. Sampah organik berlumpur atau cair memerlukan pemisahan awal atau penirisan. Pembakaran sampah basah menuntut konsumsi bahan bakar lebih tinggi untuk proses penguapan air (*evaporasi*) sebelum fase nyala api tercapai.
        </p>
      </div>
    </div>
  </section>

  <!-- Operational Considerations -->
  <section class="py-16 bg-white border-b border-[#E2E6E1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <div>
          <h2 class="text-2xl font-bold text-[#123F35] mb-4">
            Tantangan Teknis Pengolahan Sampah Basah
          </h2>
          <p class="text-sm text-[#576360] leading-relaxed mb-6">
            Kandungan air di atas 40-50% menyerap sebagian besar energi panas ruang bakar. Tanpa perancangan rekayasa yang tepat, kondisi ini dapat menyebabkan:
          </p>

          <ul class="space-y-3 text-xs sm:text-sm text-[#576360]">
            <li class="p-3 bg-[#F3F5F2] rounded border border-[#E2E6E1]">
              <strong class="text-[#123F35] block mb-1">Penurunan Suhu Ruang Bakar:</strong>
              <span>Suhu tungku turun di bawah 800°C yang memicu pembakaran tidak sempurna dan uap putih pekat.</span>
            </li>
            <li class="p-3 bg-[#F3F5F2] rounded border border-[#E2E6E1]">
              <strong class="text-[#123F35] block mb-1">Peningkatan Konsumsi Bahan Bakar:</strong>
              <span>Burner harus terus menyala dengan daya maksimum guna mempertahankan temperatur kerja.</span>
            </li>
            <li class="p-3 bg-[#F3F5F2] rounded border border-[#E2E6E1]">
              <strong class="text-[#123F35] block mb-1">Potensi Korosi Asam Kondensasi:</strong>
              <span>Uap air yang bercampur gas buang membutuhkan bahan refractory tahan korosi dan scrubber tahan asam.</span>
            </li>
          </ul>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-[#123F35] mb-4">
            Solusi Rekayasa AtasiLimbah
          </h2>
          <p class="text-sm text-[#576360] leading-relaxed mb-6">
            Model AL-DB100 mengintegrasikan tiga mekanisme penanganan sampah basah terpadu:
          </p>

          <div class="space-y-3 text-xs sm:text-sm text-[#576360]">
            <div class="p-3.5 bg-[#F3F5F2] rounded border border-[#E2E6E1]">
              <strong class="text-[#123F35] block mb-1">01. Radiant Pre-Drying Hearth</strong>
              <span>Memanfaatkan panas radiasi dari ruang kedua untuk memanaskan dan mengurangi kadar air sampah sebelum didorong ke ruang bakar utama.</span>
            </div>
            <div class="p-3.5 bg-[#F3F5F2] rounded border border-[#E2E6E1]">
              <strong class="text-[#123F35] block mb-1">02. High Capacity Modulating Burner</strong>
              <span>Burner berdaya dorong tinggi yang mempertahankan suhu stabil meski diisi material dengan kadar air fluktuatif.</span>
            </div>
            <div class="p-3.5 bg-[#F3F5F2] rounded border border-[#E2E6E1]">
              <strong class="text-[#123F35] block mb-1">03. Venturi Wet Scrubber & Mist Eliminator</strong>
              <span>Pemisahan uap basah dan penyerapan aroma tak sedap menggunakan sistem sirkulasi spray air bertingkat.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Models -->
  <section class="py-16 bg-[#F3F5F2] border-b border-[#E2E6E1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-[#123F35] block mb-2">Model Rekayasa Basah</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#123F35] tracking-tight">
          Pilihan Mesin Incinerator Sampah Basah
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-2xl">
        {wetProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </section>

  <!-- Contextual Single Consultation CTA -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#123F35] tracking-tight">
        Konsultasikan Uji Karakteristik Sampah Basah Anda
      </h2>
      <p class="text-sm sm:text-base text-[#576360] leading-relaxed max-w-2xl mx-auto">
        Kirimkan estimasi kadar air atau jenis sampah sisa makanan fasilitas Anda untuk mendapatkan evaluasi kelayakan termal dan perhitungan konsumsi bahan bakar yang realistis.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 text-xs sm:text-sm font-bold text-white bg-[#123F35] hover:bg-[#0e3129] rounded-full shadow-xs transition-colors"
        >
          Konsultasi Mesin Sampah Basah
        </a>
        <a
          href="/permintaan-penawaran/"
          class="text-xs sm:text-sm text-slate-600 hover:text-slate-950 underline underline-offset-4 transition-colors py-1"
        >
          Atau kirim formulir RFQ &rarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
