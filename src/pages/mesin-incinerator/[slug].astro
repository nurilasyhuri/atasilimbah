---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductSpecTable from '../../components/ProductSpecTable.astro';
import { COMPANY_INFO } from '../../data/companyInfo';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const data = product.data;
const { Content } = await render(product);

const pageTitle = data.title.includes('Spesifikasi')
  ? `${data.title} - AtasiLimbah`
  : `${data.title} Spesifikasi - AtasiLimbah`;
const pageDescription = data.description;

const waText = encodeURIComponent(`Halo Tim AtasiLimbah, saya ingin meminta penawaran dan spesifikasi detail untuk model ${data.title} (${data.modelCode}).`);
const waUrl = `https://wa.me/${COMPANY_INFO.contact.whatsappNumber}?text=${waText}`;

const formattedPrice = data.price
  ? `Rp ${Number(data.price).toLocaleString('id-ID')},-`
  : 'Hubungi Tim Penjualan';

const productSchema = {
  '@type': 'Product',
  name: data.title,
  model: data.modelCode,
  description: data.description,
  brand: {
    '@type': 'Brand',
    name: COMPANY_INFO.name,
  },
  manufacturer: {
    '@type': 'Organization',
    name: COMPANY_INFO.legalName,
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'IDR',
    price: data.price || '0',
    availability: 'https://schema.org/InStock',
    seller: {
      '@type': 'Organization',
      name: COMPANY_INFO.name,
    },
  },
};
---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={productSchema}>
  <!-- Breadcrumb & Header -->
  <section class="bg-slate-50 py-10 lg:py-14 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1.5">
          <li><a href="/" class="hover:underline">Beranda</a></li>
          <li><span>/</span></li>
          <li><a href="/mesin-incinerator/" class="hover:underline">Katalog</a></li>
          <li><span>/</span></li>
          <li class="font-semibold text-slate-900">{data.modelCode}</li>
        </ol>
      </nav>

      <div class="max-w-4xl">
        <div class="text-xs uppercase tracking-widest text-orange-600 font-bold font-tech mb-2">
          KAPASITAS: {data.nominalCapacity.toUpperCase()}
        </div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-950 tracking-[-0.015em] mb-3">
          {data.title}
        </h1>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          {data.description}
        </p>

        <!-- Price Banner -->
        <div class="mt-5 p-4 sm:p-5 rounded-2xl bg-white border border-slate-200/90 shadow-2xs flex flex-col sm:flex-row sm:items-center justify-between gap-4 max-w-2xl">
          <div>
            <span class="text-xs uppercase tracking-wider text-orange-600 font-bold block mb-1">
              Harga Resmi Pabrik:
            </span>
            <span class="text-2xl sm:text-3xl font-black text-slate-950 font-tech">
              {formattedPrice}
            </span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-emerald-700 font-tech">
              ✓ Non-BBM Smokeless System
            </span>
          </div>
        </div>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 max-w-4xl">
        <div class="bg-white p-3.5 rounded-xl border border-slate-200">
          <span class="block text-xs font-medium text-slate-500 uppercase">Kapasitas Desain</span>
          <span class="text-sm font-bold text-slate-950 font-tech">{data.nominalCapacity}</span>
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-slate-200">
          <span class="block text-xs font-medium text-slate-500 uppercase">Suhu Ruang Bakar</span>
          <span class="text-sm font-bold text-orange-600 font-tech">{data.operatingTemp || '800°C - 1.000°C'}</span>
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-slate-200">
          <span class="block text-xs font-medium text-slate-500 uppercase">Daya Listrik</span>
          <span class="text-sm font-bold text-slate-950 font-tech">{data.electricPower.split(',')[0]}</span>
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-slate-200">
          <span class="block text-xs font-medium text-slate-500 uppercase">Filtrasi Emisi</span>
          <span class="text-sm font-bold text-slate-950 truncate block">{data.emissionControl.split('&')[0]}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Content & Specification Table -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <!-- Main Column -->
        <div class="lg:col-span-8 space-y-10">
          <!-- Product Photo Showcase -->
          <div class="rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 p-4 sm:p-6 text-center">
            <img
              src={data.image || '/images/hero-incinerator.webp'}
              alt={`Mesin ${data.title}`}
              class="w-full max-h-[460px] object-contain rounded-xl mx-auto shadow-xs"
              width="800"
              height="500"
              loading="eager"
            />
            <div class="mt-3 text-xs text-slate-500 flex items-center justify-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Foto unit fabrikasi workshop AtasiLimbah model {data.modelCode}</span>
            </div>
          </div>

          <!-- Article / Markdown Content -->
          <div class="prose prose-slate max-w-none prose-headings:text-slate-950 prose-headings:font-bold prose-h2:text-2xl prose-h3:text-lg text-base leading-relaxed">
            <Content />
          </div>

          <!-- Technical Disclaimer if present -->
          {data.disclaimer && (
            <div class="p-4 sm:p-5 bg-orange-50 border-l-4 border-orange-500 rounded-r-xl text-xs sm:text-sm text-slate-800 leading-relaxed">
              <strong class="font-bold text-orange-800 block mb-1">Pemberitahuan Kepatuhan & Karakteristik Bahan:</strong>
              <p>{data.disclaimer}</p>
            </div>
          )}

          <!-- Technical Spec Table Section -->
          <div>
            <h2 class="text-2xl font-bold text-slate-950 mb-2">
              Tabel Spesifikasi Teknis Lengkap
            </h2>
            <p class="text-sm text-slate-600 mb-6">
              Data teknis di bawah ini mengacu pada standar rekayasa pabrikasi AtasiLimbah dan hasil pengujian pembakaran terkontrol.
            </p>
            <ProductSpecTable specs={data} />
          </div>

          <!-- Bottom Action Box -->
          <div class="p-6 sm:p-8 bg-slate-50 rounded-2xl border border-slate-200 space-y-4">
            <h3 class="text-lg font-bold text-slate-950">
              Butuh Penyesuaian Dimensi atau Sistem untuk Kapasitas Ini?
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Tim engineering kami dapat menyesuaikan ketinggian cerobong, arah pembuangan abu, atau menambahkan opsi pengumpan sampah hidrolik sesuai layout fasilitas Anda.
            </p>
            <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-xs sm:text-sm font-bold text-white bg-orange-600 hover:bg-orange-700 transition-colors shadow-xs"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                Konsultasikan Model Ini via WhatsApp
              </a>
              <a
                href="/permintaan-penawaran/"
                class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-full text-xs sm:text-sm font-semibold text-slate-800 bg-white border border-slate-300 hover:border-orange-500 hover:text-orange-600 transition-colors"
              >
                Minta Surat Penawaran SPH Resmi
              </a>
            </div>
          </div>
        </div>

        <!-- Sticky Sidebar Overview -->
        <aside class="lg:col-span-4 space-y-6">
          <div class="bg-slate-50 p-6 sm:p-7 rounded-2xl border border-slate-200 sticky top-28 space-y-6">
            <h3 class="text-base font-bold text-slate-950 border-b border-slate-200 pb-3">
              Ringkasan Rekayasa
            </h3>

            <div class="space-y-3.5 text-xs text-slate-600">
              <div>
                <span class="block font-semibold text-slate-900">Pabrikan Resmi:</span>
                <span>{COMPANY_INFO.legalName}</span>
              </div>
              <div>
                <span class="block font-semibold text-slate-900">Lokasi Workshop Fabrikasi:</span>
                <span>{COMPANY_INFO.contact.workshopAddress}</span>
              </div>
              <div>
                <span class="block font-semibold text-slate-900">Garansi:</span>
                <span>{data.warranty}</span>
              </div>
              <div>
                <span class="block font-semibold text-slate-900">Status Ketersediaan:</span>
                <span class="text-emerald-700 font-semibold">Fabrikasi Siap Kirim Seluruh Indonesia</span>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-200">
              <a
                href="/permintaan-penawaran/"
                class="block w-full text-center px-4 py-3 rounded-full text-xs font-bold text-white bg-orange-600 hover:bg-orange-700 transition-colors shadow-xs"
              >
                Minta Surat SPH
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
