---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY_INFO } from '../data/companyInfo';

const solution = await getEntry('solutions', 'solusi-sampah-institusi');
if (!solution) {
  throw new Error('Solution not found');
}
const { Content } = await render(solution);
const data = solution.data;

const pageTitle = 'Solusi Sampah Mandiri Institusi & Pesantren - AtasiLimbah';
const pageDescription = 'Pengolahan sampah mandiri untuk pondok pesantren, sekolah, dan kampus dengan mesin incinerator dual chamber untuk mereduksi sampah harian seketika.';

const waText = encodeURIComponent('Halo Tim AtasiLimbah, saya ingin berkonsultasi mengenai solusi pengolahan sampah untuk pesantren / institusi pendidikan.');
const waUrl = `https://wa.me/${COMPANY_INFO.contact.whatsappNumber}?text=${waText}`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Header -->
  <section class="bg-[#F3F5F2] py-12 lg:py-16 border-b border-[#E2E6E1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-[#576360] mb-4" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1.5">
          <li><a href="/" class="hover:underline">Beranda</a></li>
          <li><span>/</span></li>
          <li><a href="/solusi-pengolahan-sampah/" class="hover:underline">Solusi Sektoral</a></li>
          <li><span>/</span></li>
          <li class="font-semibold text-[#123F35]">Institusi & Pendidikan</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-[#123F35]/10 text-[#123F35] text-xs font-bold rounded mb-3 font-tech">
          SEKTOR PENDIDIKAN & ASRAMA
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#123F35] tracking-tight mb-4">
          Solusi Pengolahan Sampah Institusi & Pesantren
        </h1>
        <p class="text-base text-[#576360] leading-relaxed">
          {data.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Detailed Analysis -->
  <section class="py-16 bg-white border-b border-[#E2E6E1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-8 space-y-10">
          <div class="prose prose-slate max-w-none prose-headings:text-[#123F35] prose-headings:font-bold text-sm sm:text-base leading-relaxed">
            <Content />
          </div>

          <!-- Problem & Solution Checklist -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
            <div class="p-6 bg-red-50/50 rounded-lg border border-red-200">
              <h3 class="text-base font-bold text-red-900 mb-3">Tantangan Umum:</h3>
              <ul class="space-y-2 text-xs text-red-950">
                {data.commonIssues.map((issue) => (
                  <li class="flex items-start gap-2">
                    <span class="text-red-700 font-bold shrink-0">&bull;</span>
                    <span>{issue}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="p-6 bg-[#F3F5F2] rounded-lg border border-[#E2E6E1]">
              <h3 class="text-base font-bold text-[#123F35] mb-3">Manfaat Penerapan:</h3>
              <ul class="space-y-2 text-xs text-[#576360]">
                {data.benefits.map((benefit) => (
                  <li class="flex items-start gap-2">
                    <span class="text-[#123F35] font-bold shrink-0">&check;</span>
                    <span>{benefit}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Sidebar Recommendations -->
        <aside class="lg:col-span-4 space-y-6">
          <div class="bg-[#F3F5F2] p-6 rounded-lg border border-[#E2E6E1] space-y-4">
            <h3 class="text-base font-bold text-[#123F35] border-b border-[#E2E6E1] pb-3">
              Rekomendasi Tipe Mesin
            </h3>
            <ul class="space-y-3 text-xs text-[#576360]">
              {data.recommendedSystems.map((sys) => (
                <li class="p-3 bg-white rounded border border-[#E2E6E1]">
                  <strong class="text-[#123F35] block mb-1 font-semibold">{sys.split('(')[0]}</strong>
                  <span>{sys.includes('(') ? `(${sys.split('(')[1]}` : ''}</span>
                </li>
              ))}
            </ul>
            <div class="pt-2">
              <a
                href="/mesin-incinerator/al-200h/"
                class="block w-full text-center px-4 py-2.5 text-xs font-semibold text-white bg-[#123F35] hover:bg-[#1a574a] rounded transition-colors"
              >
                Lihat Spesifikasi Kapasitas 200 Kg/Hari
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Contextual Single Consultation CTA -->
  <section class="py-16 bg-[#F3F5F2]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#123F35] tracking-tight">
        Rencanakan Pengelolaan Sampah Mandiri di Lembaga Anda
      </h2>
      <p class="text-sm sm:text-base text-[#576360] leading-relaxed max-w-2xl mx-auto">
        Ketahui simulasi volume sampah harian berdasarkan jumlah santri / civitas kampus serta kaji kelayakan penempatan unit di lokasi Anda.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 text-xs sm:text-sm font-bold text-white bg-[#123F35] hover:bg-[#0e3129] rounded-full shadow-xs transition-colors"
        >
          Konsultasi Solusi Pesantren via WhatsApp
        </a>
        <a
          href="/permintaan-penawaran/"
          class="text-xs sm:text-sm text-slate-600 hover:text-slate-950 underline underline-offset-4 transition-colors py-1"
        >
          Atau kirim formulir RFQ proyek &rarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
