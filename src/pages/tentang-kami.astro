---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY_INFO } from '../data/companyInfo';

const pageTitle = 'Tentang Kami Produsen Mesin Incinerator - AtasiLimbah';
const pageDescription = 'Profil AtasiLimbah sebagai produsen mesin incinerator Indonesia dan sistem pengolahan sampah termal terpercaya untuk berbagai sektor fasilitas.';

const waText = encodeURIComponent('Halo Tim AtasiLimbah, saya ingin berkonsultasi mengenai profil perusahaan dan kunjungan workshop fabrikasi mesin.');
const waUrl = `https://wa.me/${COMPANY_INFO.contact.whatsappNumber}?text=${waText}`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Header -->
  <section class="bg-[#F3F5F2] py-12 lg:py-16 border-b border-[#E2E6E1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-[#576360] mb-4" aria-label="Breadcrumb">
        <ol class="flex items-center gap-1.5">
          <li><a href="/" class="hover:underline">Beranda</a></li>
          <li><span>/</span></li>
          <li class="font-semibold text-[#1E482C]">Tentang Kami</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-[#1E482C]/10 text-[#1E482C] text-xs font-bold rounded mb-3 font-tech">
          PROFIL PRODUSEN RESMI
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1E482C] tracking-tight mb-4">
          Teknologi Tepat untuk Pengolahan Limbah
        </h1>
        <p class="text-base text-[#576360] leading-relaxed">
          AtasiLimbah adalah brand produsen mesin incinerator Indonesia yang berfokus pada penyediaan teknologi pengolahan sampah termal untuk kebutuhan institusi, kawasan komersial, fasilitas usaha, dan industri.
        </p>
      </div>
    </div>
  </section>

  <!-- Core Positioning & Values -->
  <section class="py-16 bg-white border-b border-[#E2E6E1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-7 space-y-6">
          <h2 class="text-2xl sm:text-3xl font-bold text-[#1E482C]">
            Posisi Brand & Pendekatan Rekayasa
          </h2>
          <p class="text-sm sm:text-base text-[#576360] leading-relaxed">
            Kami memahami bahwa sampah bukanlah material homogen yang bisa diselesaikan dengan satu tipe mesin seragam. Setiap fasilitas memiliki karakteristik sampah, kadar air, nilai kalor, serta batasan lahan yang berbeda.
          </p>
          <p class="text-sm sm:text-base text-[#576360] leading-relaxed">
            Karena itu, AtasiLimbah menawarkan mesin berdasarkan evaluasi teknis mendalam: mengkalkulasi neraca massa, merancang ruang bakar primer dan sekunder dengan retensi waktu optimal, serta melengkapi cerobong dengan sistem penangkap abu basah (*wet scrubber*) teruji.
          </p>

          <!-- Vision & Mission -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
            <div class="p-5 bg-[#F3F5F2] rounded border border-[#E2E6E1]">
              <h3 class="text-base font-bold text-[#1E482C] mb-2">Visi Kami</h3>
              <p class="text-xs text-[#576360] leading-relaxed">
                Menjadi produsen mesin incinerator dan teknologi pengolahan sampah yang paling dipercaya di Indonesia melalui pengembangan teknologi tepat guna, realistis, dan bertanggung jawab terhadap kelestarian lingkungan.
              </p>
            </div>
            <div class="p-5 bg-[#F3F5F2] rounded border border-[#E2E6E1]">
              <h3 class="text-base font-bold text-[#1E482C] mb-2">Misi Rekayasa</h3>
              <p class="text-xs text-[#576360] leading-relaxed">
                Menyediakan mesin berkualitas tinggi dengan bata api refractory teruji, mengedukasi pelanggan tentang batasan operasional mesin, dan menolak klaim palsu yang menyesatkan calon pembeli.
              </p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 space-y-6">
          <div class="bg-[#1E482C] text-white p-6 sm:p-8 rounded-lg border border-[#2D5A3A] space-y-4">
            <h3 class="text-lg font-bold text-white border-b border-white/15 pb-3">
              Identitas Badan Usaha
            </h3>
            <div class="space-y-3 text-xs text-slate-200">
              <div>
                <span class="block text-slate-400">Nama Badan Hukum:</span>
                <span class="font-semibold text-white">{COMPANY_INFO.legalName}</span>
              </div>
              <div>
                <span class="block text-slate-400">Brand Dagang Resmi:</span>
                <span class="font-semibold text-white">{COMPANY_INFO.name}</span>
              </div>
              <div>
                <span class="block text-slate-400">Domisili Fabrikasi:</span>
                <span>{COMPANY_INFO.contact.workshopAddress}</span>
              </div>
              <div>
                <span class="block text-slate-400">Layanan Inti:</span>
                <span>Fabrikasi Mesin Incinerator, Konsultasi Teknis Termal, Rancang Bangun Custom Scrubber</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contextual Single Consultation CTA -->
  <section class="py-16 bg-[#F3F5F2]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#1E482C] tracking-tight">
        Kunjungi Workshop Fabrikasi Kami
      </h2>
      <p class="text-sm sm:text-base text-[#576360] leading-relaxed max-w-2xl mx-auto">
        Jadwalkan kunjungan kerja ke workshop untuk melihat langsung proses perakitan rangka mesin, pemasangan bata refractory tahan api, dan pengujian burner.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 text-xs sm:text-sm font-bold text-white bg-[#1E482C] hover:bg-[#153620] rounded-full shadow-xs transition-colors"
        >
          Hubungi Tim Melalui WhatsApp
        </a>
        <a
          href="/permintaan-penawaran/"
          class="text-xs sm:text-sm text-slate-600 hover:text-slate-950 underline underline-offset-4 transition-colors py-1"
        >
          Atau kirim formulir RFQ &rarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
