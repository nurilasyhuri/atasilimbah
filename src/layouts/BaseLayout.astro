---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  image,
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      jsonLd={jsonLd}
      noindex={noindex}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-[#1E2926] antialiased">
    <Header />
    <main id="main-content" class="flex-grow">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />
  </body>
</html>